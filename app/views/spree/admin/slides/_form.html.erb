<div class="row mb-3">
  <div class="col-md-6">
    <%= f.label :name, t(:name) %><br>
    <%= f.text_field :name, class: 'fullwidth form-control' %>
  </div>

  <div class="col-md-6">
    <%= f.label :link_url, t(:link_url) %><br>
    <%= f.text_field :link_url, class: 'fullwidth form-control' %>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-6">
    <%= f.label :image, t(:image) %><br>
    <%= f.file_field :image %>
  </div>

  <div class="col-md-6 pt-3">
    <div class="custom-control custom-checkbox">
      <%= f.check_box :published, class: "custom-control-input" %>
      <%= f.label :published, class: 'custom-control-label' %>
    </div>
  </div>
</div>

<div class="row mb-2">
  <div class="col-md-6">
    <%= f.label :slide_location_id, Spree.t(:location) %>
    <%= tom_select_tag 'slide[slide_location_ids]', class: 'w-100', options: Spree::SlideLocation.pluck(:id, :name).map{|id, name| {id: id, name: name}}.as_json, active_option: @slide.slide_locations.first.try(:id), value_field: :id %>

    <%= f.error_message_on :slide_location %>
  </div>

  <div class="col-md-6">
    <% if f.object.image.attached? %>
      <p>
        <%= label_tag t(:preview) %>
        <br>
        <%= image_tag main_app.url_for(f.object.thumbnail), class: 'img-responsive' %>
      </p>
    <% end %>
  </div>
</div>
