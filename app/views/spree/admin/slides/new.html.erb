<% content_for :page_title do %>
  <%= page_header_back_button spree.admin_slides_url, @slide %>
  <%= t('spree_slider.new_slide') %>
<% end %>

<%= render partial: "spree/admin/shared/error_messages",
locals: {
  target: @slide,
} %>

<%= form_for [:admin, @slide] , html: { multipart: true } do |f| %>
  <fieldset class="no-border-top">
    <%= render partial: 'form', locals: { f: f } %>

    <div class="clear"></div>

    <div data-hook="admin_shipping_method_new_form_buttons">
      <%= render partial: 'spree/admin/shared/new_resource_links' %>
    </div>
  </fieldset>
<% end %>
