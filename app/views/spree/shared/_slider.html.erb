<% if slider.size > 0 %>
  <% cid ||= Random.rand(1000) %>

  <div id="carousel-slider-<%= cid %>"
       class="swiper-container overflow-hidden relative w-full h-[400px] md:h-[500px] rounded-lg"
       data-controller="carousel"
       data-carousel-options-value='{
         "slidesPerView": 1,
         "centeredSlides": true,
         "loop": true,
         "autoplay": {
           "delay": 3000,
           "disableOnInteraction": false
         },
         "pagination": {
           "el": ".swiper-pagination",
           "clickable": true
         }
       }'>

    <div class="swiper-wrapper">
      <% slider.each do |slide| %>
        <% image_url = slide.slide_image ? main_app.url_for(slide.slide_image) : "noimage/large" %>
        <div class="swiper-slide relative w-full h-[200px] flex items-center justify-center bg-gray-100">
          <%= link_to url_for(slide&.link_url), class: "block w-full h-full flex items-center justify-center" do %>
            <%= image_tag(image_url,
              alt: slide.name,
              class: "w-full h-[200px] object-cover rounded-lg") %>
          <% end %>

          <% if slide.name.present? || slide.body.present? %>
            <div class="absolute bottom-5 left-5 bg-black/50 text-white px-4 py-2 rounded-lg max-w-[80%]">
              <h3 class="text-lg font-semibold"><%= slide.name %></h3>
              <% unless slide.body.blank? %>
                <p class="text-sm"><%= slide.body %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Pagination dots -->
    <div class="swiper-pagination !relative mt-4 flex justify-center"></div>
  </div>
<% end %>


